{
  "name": "fecode-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "fe": "npm run dev --workspace=apps/cli",
    "dev": "npm run dev --workspace=apps/cli",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=packages/models && npm run build --workspace=packages/agent && npm run build --workspace=apps/cli",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0",
    "vitest": "^2.1.8"
  }
}
